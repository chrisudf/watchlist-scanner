# watchlist-scanner email push — copy to the project root as .env and fill in.
#
# 两条通道, 有 SCAN_RESEND_API_KEY 就优先走 HTTPS。
#
# (A) Resend (HTTPS 443) — 云主机上用这条。DigitalOcean 等默认封锁 droplet
#     的出站 SMTP (25/465/587/2525 全部静默超时, 443 正常), Gmail SMTP 在
#     那种机器上永远连不上。沙箱发件地址 onboarding@resend.dev 只能发给
#     Resend 账号自己的邮箱; 要发给别人得先验证自己的域名。
SCAN_RESEND_API_KEY=re_xxxxxxxxxxxx
SCAN_EMAIL_FROM=onboarding@resend.dev
SCAN_EMAIL_TO=you@example.com
#
# (B) SMTP — 本机/不封端口的机器用这条 (留空 SCAN_RESEND_API_KEY 即可)。
#     Gmail 要用 App Password (Google 账户 -> 安全 -> 两步验证 -> 应用专用密码),
#     不是登录密码。
# SCAN_SMTP_HOST=smtp.gmail.com
# SCAN_SMTP_PORT=587
# SCAN_SMTP_USER=you@gmail.com
# SCAN_SMTP_PASS=app-password-here
