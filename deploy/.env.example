# watchlist-scanner email push — copy to the project root as .env and fill in.
# Gmail: use an App Password (Google account -> Security -> App passwords).
SCAN_SMTP_HOST=smtp.gmail.com
SCAN_SMTP_PORT=587
SCAN_SMTP_USER=you@gmail.com
SCAN_SMTP_PASS=app-password-here
SCAN_EMAIL_TO=you@example.com
# SCAN_EMAIL_FROM="watchlist-scanner <you@gmail.com>"
